LICENSE_CODE_PEPPER=REPLACE_STAGING_CODE_PEPPER_32_CHARS
LICENSE_DEVICE_CREDENTIAL_PEPPER=REPLACE_STAGING_CREDENTIAL_PEPPER_32_CHARS
LICENSE_ADMIN_SESSION_SECRET=REPLACE_STAGING_SESSION_SECRET_32_CHARS
LICENSE_ADMIN_TOTP_ENCRYPTION_KEY=REPLACE_STAGING_TOTP_ENCRYPTION_KEY
